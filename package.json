{
  "name": "myke-ai",
  "version": "1.0.0",
  "description": "MYKE AI V1 - All-in-One AI Platform",
  "main": "desktop/electron/main.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon backend/server.js",
    "dev:frontend": "vite",
    "build": "frontend\\build.bat",
    "build:desktop": "npm run build && electron-builder",
    "build:mobile": "npm run build && npx cap sync",
    "electron": "electron desktop/electron/main.js",
    "electron:dev": "concurrently \"npm run dev:frontend\" \"wait-on http://localhost:5173 && electron desktop/electron/main.js\"",
    "capacitor:add": "npx cap add android && npx cap add ios",
    "capacitor:sync": "npx cap sync",
    "capacitor:open:android": "npx cap open android",
    "capacitor:open:ios": "npx cap open ios",
    "db:migrate": "node backend/database/migrate.js",
    "db:seed": "node backend/database/seed.js",
    "test": "jest",
    "lint": "eslint . --ext .js,.html,.css"
  },
  "keywords": [
    "ai",
    "chatbot",
    "myke-ai",
    "myke-gpt",
    "electron",
    "capacitor",
    "pwa"
  ],
  "author": "MYKE AI",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "openai": "^4.24.1",
    "socket.io": "^4.7.2",
    "sql.js": "^1.14.2",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@capacitor/android": "^5.6.0",
    "@capacitor/cli": "^5.6.0",
    "@capacitor/core": "^5.6.0",
    "@capacitor/ios": "^5.6.0",
    "@vitejs/plugin-legacy": "^5.3.0",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "vite": "^5.0.10",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ]
}
