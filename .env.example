# MYKE AI V1 - Environment Configuration
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
APP_NAME=MYKE AI
APP_VERSION=1.0.0
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Server
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:./data/myke-ai.db
DATABASE_POOL_SIZE=10

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Session
SESSION_SECRET=your-session-secret-change-in-production
SESSION_MAX_AGE=604800000

# MYKE GPT Configuration
MYKE_GPT_VERSION=V1
MYKE_GPT_MODEL_PATH=./models/myke-gpt-v1
MYKE_GPT_CONTEXT_LENGTH=8192
MYKE_GPT_TEMPERATURE=0.7
MYKE_GPT_MAX_TOKENS=4096

# External AI Providers (fallback when MYKE GPT not available)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# Image Generation
IMAGE_PROVIDER=none
IMAGE_API_KEY=
IMAGE_API_URL=
STABLE_DIFFUSION_URL=http://localhost:7860

# Speech Services
SPEECH_PROVIDER=web-speech
SPEECH_API_KEY=
SPEECH_API_URL=
TTS_PROVIDER=web-speech
TTS_API_KEY=
TTS_API_URL=

# Web Search
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=
WEB_SEARCH_API_URL=

# File Storage
UPLOAD_MAX_SIZE=52428800
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=txt,pdf,docx,xlsx,csv,json,js,ts,py,java,cpp,cs,html,css,md,json,yaml,xml,png,jpg,jpeg,gif,webp,svg,mp3,wav,ogg,mp4,webm

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
CORS_ORIGIN=http://localhost:5173
CSRF_SECRET=your-csrf-secret-change-in-production
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/myke-ai.log

# Features
ENABLE_MEMORY=true
ENABLE_WEB_SEARCH=false
ENABLE_IMAGE_GENERATION=false
ENABLE_VOICE=true
ENABLE_CODE_EXECUTION=false
ENABLE_DEVELOPER_MODE=false

# PWA
PWA_NAME=MYKE AI
PWA_SHORT_NAME=MYKE AI
PWA_DESCRIPTION=Your ideas. AI takes care of the rest.
PWA_THEME_COLOR=#1a1a2e
PWA_BACKGROUND_COLOR=#0f0f1a

# Desktop (Electron)
ELECTRON_TITLE=MYKE AI V1
ELECTRON_ICON=./frontend/assets/icon.ico
AUTO_UPDATER_URL=

# Mobile (Capacitor)
CAPACITOR_APP_ID=com.myke.ai
CAPACITOR_APP_NAME=MYKE AI
CAPACITOR_WEB_DIR=dist